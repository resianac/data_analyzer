<?php

namespace App\Services\Sources\Clients\{{ name }}\Data;

use App\Data\EntityData;
use App\Services\Sources\Enums\EntityFilter;
use Spatie\LaravelData\Data;

class {{ name }}Data extends Data
{
    public function __construct(
        // TODO: entity fields
    ) {}

    /**
     * Transform data to general DTO
     *
     * @param EntityFilter $filter
     * @param {{ name }}SearchParam $searchParam
     * @return EntityData|null
     */
    public function toGeneral(EntityFilter $filter, {{ name }}SearchParam $searchParam): ?EntityData
    {
        $matchId = {{ name }}NormalizerFactory::make($searchParam)->normalize($this);

        if ($matchId === null) {
            return null;
        }

        return {{ name }}DataAdapter::toGeneral($this, $filter, $matchId);
    }
}
